{
  "name": "dsh-disk-cleanup",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only disk cleanup scanner for DeepSeek Harness: scans a drive and writes size-sorted cleanup reports without deleting, moving, or modifying anything.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "README.md",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
